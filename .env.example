# ============================================================
# Mythos — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ----- Core -----
MYTHOS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
MYTHOS_PROJECT_NAME=Project Mythos
MYTHOS_CONFIDENCE_THRESHOLD=0.5        # Attribution confidence floor
MYTHOS_RISK_CRITICAL_THRESHOLD=0.8     # Risk score → CRITICAL label threshold

# ----- Database (leave blank to use SQLite for local dev) -----
DATABASE_URL=                          # postgresql+asyncpg://user:pass@host:5432/mythos

# ----- Redis (leave blank to use in-memory fallback) -----
REDIS_URL=                             # redis://localhost:6379/0

# ----- Authentication -----
JWT_SECRET_KEY=                        # REQUIRED in production: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- API Server -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*                         # Restrict to specific origins in production
SQL_ECHO=false                         # Set true only for local SQL debugging

# ----- Featherless AI (leave blank to run in mock mode) -----
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ----- BandAI multi-agent platform (leave blank to run in mock mode) -----
BANDAI_PLANNER_ID=
BANDAI_FORENSICS_ID=
BANDAI_COMPLIANCE_ID=
BANDAI_BASE_URL=https://api.bandai.ai/v1
